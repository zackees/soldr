# `_vender/zccache/.vendor-state` — see docs/VENDORING.md
#
# Provenance: what upstream commit this snapshot was taken from.
upstream_repo = "https://github.com/zackees/zccache.git"
upstream_branch = "main"
upstream_sha = "fde4b916f24d9fe1cd00aeabe6581e4972f32068"
upstream_tag_at_sync = "1.12.11"

# Cadence: when this vendor was created and when it MUST end. CI
# refuses to build past `deadline`. Bumping the deadline requires
# a comment on the driving issue explaining why the target slipped.
synced_at = "2026-06-26T19:30:00Z"
deadline = "2026-07-10T00:00:00Z"

# Driver: the soldr issue that brought the vendor into existence.
# Closes when the vendor retires (per docs/VENDORING.md "Ending the
# vendor" procedure).
driving_issue = "https://github.com/zackees/soldr/issues/983"

# Local deltas: every soldr-side commit that touches files inside
# _vender/zccache/. Each entry MUST cite its matching upstream PR
# within 7 days of the soldr-side landing. CI fails if any older
# entry has `upstream_pr = null`.
#
# Schema:
#   [[deltas]]
#   soldr_commit = "<sha>"
#   summary      = "<one-line>"
#   upstream_pr  = "<url>" | null
#
# Initial state: no deltas. Subagents B/C/D will populate this as
# they land changes.

[[deltas]]
soldr_commit = "HEAD"
summary = "embedded: streaming compile (chunked rustc pipes instead of wait_with_output)"
upstream_pr = null
