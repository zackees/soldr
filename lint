#!/bin/bash
set -e

./install

echo Running ruff src
uv run --no-sync ruff check --fix src
echo Running ruff tests
uv run --no-sync ruff check --fix tests
# Same four directories CI checks. Contributor/CI parity is the point: a lint
# that passes locally and fails in CI is worse than no lint locally.
echo Running ruff .github/scripts ci
uv run --no-sync ruff check --fix .github/scripts ci
echo Running black src tests
uv run --no-sync black src tests
echo Running isort src tests
uv run --no-sync isort --profile black src tests
echo Running flake8 src tests
uv run --no-sync flake8 src tests
echo Running pylint src
uv run --no-sync pylint src
echo Running pylint tests
uv run --no-sync pylint --rcfile=tests/.pylintrc tests
# Same scope CI checks. `ci/` is excluded in both places because its
# `fcntl.flock` findings are Windows-only and would make this pass or fail
# depending on the contributor's OS.
echo Running mypy src tests .github/scripts
uv run --no-sync mypy src tests .github/scripts
echo Linting complete!
exit 0
